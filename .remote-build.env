BUILD_TRANSPORT=ssh
BUILD_USER=alireza
REMOTE_ROOT="/home/alireza/.cache/qemu-lab-build-server"

if [[ "$(uname)" == "Darwin" ]]; then
    BUILD_HOST=server-c
    QEMU_LOCAL_SRC_DIR="${HOME}/dojang/qemu-lab"
else
    BUILD_HOST=x86
    QEMU_LOCAL_SRC_DIR="${HOME}/playground/qemu-lab"
fi
QEMU_LOCAL_BUILD_DIR="${QEMU_LOCAL_SRC_DIR}/build/remote-qemu"
QEMU_CONFIGURE_ARGS=(
    --target-list="x86_64-softmmu, aarch64-softmmu",
)
QEMU_EXTRA_MAKE_ARGS=()

# Set this when you are ready to offload kernel builds too.
# KERNEL_LOCAL_SRC_DIR="${HOME}/src/linux"
KERNEL_LOCAL_BUILD_DIR="${QEMU_LOCAL_SRC_DIR}/build/remote-kernel"
KERNEL_ARCH=x86_64
KERNEL_CONFIG_TARGET=defconfig
KERNEL_BUILD_TARGETS=(bzImage modules)
KERNEL_EXTRA_MAKE_ARGS=()
