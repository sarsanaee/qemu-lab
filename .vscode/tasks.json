{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Server: doctor",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "doctor"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "QEMU: build on server",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "qemu-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "QEMU: reconfigure and build on server",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "qemu-build",
                "--reconfigure"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "QEMU: pull server artifacts",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "qemu-pull"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Kernel: build on server",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "kernel-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Kernel: reconfigure and build on server",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "kernel-build",
                "--reconfigure"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Kernel: pull server artifacts",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "kernel-pull"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build Server: shell",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/remote-build.sh",
                "shell"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-l", "-c"]
                }
            },
            "problemMatcher": []
        }
    ]
}
